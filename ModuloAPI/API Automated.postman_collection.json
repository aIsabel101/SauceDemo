    "name": "API Automated",
    "description": "Postman Collection for ReqRes API testing covering POST /api/users, GET /api/users/{id}, and additional edge/negative test cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "57764034",
