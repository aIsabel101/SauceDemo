  },
  "item": [
    {
      "name": "Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Verify HTTP Status Code is 201 Created",
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "// 2. Validate Response Body Structure",
              "const responseData = pm.response.json();",
              "pm.test('Response contains name, job, id, and createdAt', function () {",
              "    pm.expect(responseData).to.have.property('name', 'Test User');",
              "    pm.expect(responseData).to.have.property('job', 'Automation Engineer');",
              "    pm.expect(responseData).to.have.property('id');",
              "    pm.expect(responseData).to.have.property('createdAt');",
              "});",
              "",
              "// 3. Extract and save created User ID into Collection Variable",
              "if (responseData.id) {",
              "    pm.collectionVariables.set('createdUserId', responseData.id);",
              "    console.log('Saved createdUserId:', responseData.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Test User\",\n    \"job\": \"Automation Engineer\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Retrieve Created User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Name and job match expected values', function () {",
              "    const responseData = pm.response.json();",
              "",
              "    pm.expect(responseData.name).to.eql('Test User');",
              "    pm.expect(responseData.job).to.eql('Automation Engineer');",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
